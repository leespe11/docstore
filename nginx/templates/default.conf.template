# Rendered by the nginx:alpine entrypoint (envsubst) into
# /etc/nginx/conf.d/default.conf at container start. Only ${DOMAIN_NAME},
# ${MAX_UPLOAD_MB} and ${HTTPS_PORT} are substituted — the entrypoint's
# envsubst call is scoped to the container's actual env var names, so
# nginx's own runtime variables below ($host, $remote_addr, etc.) are left
# untouched.

server {
    listen 80;
    server_name ${DOMAIN_NAME};
    # $host never includes a port, and the container itself has no idea
    # HTTP_PORT/HTTPS_PORT were remapped on the host side (Docker's port
    # publishing is invisible from inside the container) — so the external
    # HTTPS port has to come in explicitly via env var, not $server_port.
    return 301 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    server_name ${DOMAIN_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Matches MAX_UPLOAD_MB (backend's own per-file limit) so nginx isn't the
    # thing rejecting a batch before the backend even sees it.
    client_max_body_size ${MAX_UPLOAD_MB}m;

    # The browser uploads straight to the backend, bypassing the frontend's
    # Node process (see frontend/app/page.tsx and NEXT_PUBLIC_BACKEND_URL) so
    # large batches stream to disk instead of getting buffered twice.
    # proxy_request_buffering off keeps nginx itself from buffering the
    # whole body before forwarding it, for the same reason.
    location /backend/ {
        proxy_pass http://backend:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
    }

    location / {
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Next.js dev/HMR and any future streaming use — harmless in prod.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
