# Where Ollama is reachable from inside the containers.
# Default assumes Ollama runs on the host on its default port.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Where your BROWSER reaches the backend directly (uploads bypass the
# Next.js proxy — see app/page.tsx — so large batches don't get buffered
# twice). Baked into the frontend at BUILD time, so `docker compose build`
# (not just `up`) is required after changing this.
# If you open the UI from another device on your LAN, this must be that
# host's LAN IP, not localhost, e.g. http://192.168.1.50:8000.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Models (must be pulled in Ollama first: ./scripts/pull-models.ps1)
OLLAMA_LLM_MODEL=qwen2.5:14b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_EMBED_MODEL=bge-large

# Optional: a separate (often smaller/faster) model for ingest-time field
# extraction, since that's more mechanical than open-ended chat. Leave blank
# to reuse OLLAMA_LLM_MODEL. Must be pulled first if set, e.g. qwen2.5:7b.
OLLAMA_EXTRACT_MODEL=

# Embedding dimension — MUST match OLLAMA_EMBED_MODEL.
# bge-large / bge-large-en-v1.5 = 1024
EMBED_DIM=1024

# Context window (tokens) requested from Ollama for every chat/vision call.
# A rasterized page + OCR prompt can easily need >4096 tokens once the vision
# model tokenizes the image, which is Ollama's default context size — if you
# see "exceeds the available context size" in worker logs, raise this
# (uses more VRAM) or lower OCR_DPI below.
OLLAMA_NUM_CTX=32768

# How long (seconds) to wait for a single Ollama call before giving up. A
# large OLLAMA_NUM_CTX makes prompt processing on a dense document much
# slower — raise this if worker logs show "httpx.ReadTimeout".
OLLAMA_TIMEOUT_S=1800

# Max size per uploaded file (MB)
MAX_UPLOAD_MB=400

# DPI used when rasterizing PDF pages for OCR
OCR_DPI=200

# Every image sent to the vision model (rendered PDF pages AND raw image
# uploads) is downscaled to this longest-edge size and re-encoded as JPEG
# before sending. Keeps request bodies from getting large enough to 413, and
# keeps vision-token usage predictable. Lower if you still see 413s or want
# faster/cheaper OCR; raise if small print is getting misread.
OCR_MAX_DIMENSION=2000
OCR_JPEG_QUALITY=90

# Where the host-side speech-to-text service (speech-service/, for the chat
# tab's mic button) is reachable from inside the containers. Not Dockerized,
# same reason Ollama isn't — GPU access without fighting Docker GPU
# passthrough on Windows. Start it with ./scripts/run-speech-service.ps1.
# Entirely optional — if it's not running, the mic button just disables
# itself (backend polls SPEECH_BASE_URL/health; see /speech/status). Leave
# this at the default even if you never plan to run the service.
SPEECH_BASE_URL=http://host.docker.internal:8090
SPEECH_TIMEOUT_S=60

# Domain the self-signed HTTPS cert (scripts/generate-certs.ps1|sh) is
# issued for, and the nginx `server_name` it's served under (see the
# `nginx` service in docker-compose.yml, the app's only entrypoint). Leave
# as `localhost` for local-only access; set to a LAN hostname if other
# devices need to reach this over HTTPS, e.g. docstore.home. Not a public
# DNS requirement — the cert is self-signed, not Let's Encrypt (see the
# generate-certs script).
DOMAIN_NAME=localhost

# Host ports nginx publishes for HTTP (redirects to HTTPS_PORT) and HTTPS
# (the actual app). Change these if 80/443 are already taken on your host
# (common on Windows — IIS, Skype, VMware, etc. often grab 443).
HTTP_PORT=80
HTTPS_PORT=443
